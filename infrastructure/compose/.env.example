# Local development only. Copy to .env before starting Compose; never use these values outside local development.
POSTGRES_DB=localshop
POSTGRES_USER=localshop
POSTGRES_PASSWORD=localshop_dev_password
POSTGRES_HOST_PORT=25433
APP_DB_USERNAME=localshop_app
APP_DB_PASSWORD=localshop_app_dev_password

# Generate with: openssl rand -base64 32. Replace this placeholder in your local .env.
OTP_HMAC_SECRET=replace-with-a-base64-encoded-random-secret

# Generate independently with: openssl rand -base64 32.
JWT_SIGNING_SECRET=replace-with-another-base64-encoded-random-secret
JWT_ISSUER=https://api.localshop.example
JWT_AUDIENCE=local-shop-os-api
JWT_ACCESS_TOKEN_TTL=10m
JWT_REFRESH_SESSION_TTL=30d

REDIS_PASSWORD=localshop_redis_dev_password
REDIS_HOST_PORT=26380
